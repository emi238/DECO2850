{
  "expo": {
    "name": "PawSpace",
    "slug": "pawspace",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pawspace",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "PawSpace uses the camera to capture rooms and place markers in augmented reality.",
        "NSPhotoLibraryUsageDescription": "PawSpace lets you pick photos or a video of your room from your library to build the room for assessment.",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use your microphone"
      }
    },
    "android": {
      "package": "com.pawspace.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "PawSpace uses the camera to capture rooms and place markers in augmented reality."
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9d463e02-4f7f-4cc9-a5cf-43e2cfde4f00"
      }
    }
  }
}
